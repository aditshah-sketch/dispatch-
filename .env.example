# The Dispatch — environment configuration
# Copy to .env.local for local development. On Vercel, add these in
# Project → Settings → Environment Variables. Changing any value requires a
# redeploy (Vercel injects env vars at build/boot time).
#
# Nothing here is required for the PUBLIC PREVIEW (/preview), which runs on
# fictional sample data in the browser. Each capability turns on independently
# when its variables are present; Settings shows what is missing.
# Never use a NEXT_PUBLIC_ prefix for any of these: they must stay server-side.

# --- Core (required for the live desk at /desk) -----------------------------

# Public URL of the app. Used for unsubscribe links, the Google OAuth redirect,
# the Telegram webhook, and the scheduler's self-continuation. On Vercel it
# falls back to VERCEL_PROJECT_PRODUCTION_URL, but setting it is recommended.
APP_BASE_URL=http://localhost:3000

# Workspace timezone (IANA). All schedule times are interpreted in it.
APP_TIMEZONE=Asia/Kolkata

# Durable database. Any Postgres works (Neon via the Vercel Marketplace,
# Supabase, RDS…). Use the pooled connection string on serverless.
# For local development only, an embedded Postgres (PGlite) can be used:
#   DATABASE_URL=pglite:./.data/dispatch
DATABASE_URL=

# Signs the owner session cookie, OAuth state and unsubscribe links.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs out the owner AND invalidates unsubscribe links in sent emails.
AUTH_SECRET=

# Password for the single owner account (the live desk). Use a long passphrase.
OWNER_PASSWORD=
OWNER_NAME=Shreya

# Encrypts Google OAuth tokens at rest (AES-256-GCM). Generate like AUTH_SECRET.
# Changing it makes stored Google tokens unreadable → you'll be asked to reconnect.
TOKEN_ENCRYPTION_KEY=

# Protects /api/cron/* (Vercel Cron sends "Authorization: Bearer $CRON_SECRET").
CRON_SECRET=

# --- Gemini Flash (all AI tasks) ---------------------------------------------
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Verified available on 2026-10-12 (ai.google.dev/gemini-api/docs/models).
GEMINI_MODEL=gemini-3.8-flash
# Gemini 3.x thinking level: low | medium | high (low keeps cost down).
GEMINI_THINKING_LEVEL=low

# --- News search (GNews) — optional -------------------------------------------
# https://gnews.io — the free plan has a ~12-hour delay, 10 results/request,
# and is for non-commercial use. Set GNEWS_PLAN=paid on a paid plan.
GNEWS_API_KEY=
GNEWS_PLAN=free

# --- ScrapingBee (full article pages) — optional ------------------------------
SCRAPINGBEE_API_KEY=
# Credit budget: max pages fetched per collection run (1 credit each without JS).
SCRAPINGBEE_MAX_PAGES_PER_RUN=25
# JavaScript rendering costs 5 credits per page; leave off unless needed.
SCRAPINGBEE_RENDER_JS=false

# --- Telegram (review channel and reminders) ----------------------------------
# Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# Random string (A–Z, a–z, 0–9, _ and -, up to 256 chars). Telegram echoes it in
# the X-Telegram-Bot-Api-Secret-Token header so the webhook can verify requests.
TELEGRAM_WEBHOOK_SECRET=
# Optional: pin the owner's chat ID. If empty, link the chat from Settings
# (one-time code sent as "/start CODE" to the bot).
TELEGRAM_OWNER_CHAT_ID=

# --- Google OAuth (Gmail sending, delivery feedback, Calendar) ----------------
# Create an OAuth client (type: Web application) in Google Cloud Console.
# Authorised redirect URI: <APP_BASE_URL>/api/google/callback
# Tokens are obtained through the in-app "Connect Google" flow and stored
# encrypted — never paste refresh tokens here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to <APP_BASE_URL>/api/google/callback
GOOGLE_REDIRECT_URI=
